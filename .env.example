# Application Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# MongoDB Connection (Local or MongoDB Atlas)
# Leave blank in local sandbox to use automatic persistent JSON document store fallback
MONGODB_URI="mongodb://127.0.0.1:27017/neuropredict"

# JWT Authentication
JWT_SECRET="replace-with-a-strong-256-bit-secret-key"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Model Persistence Path (mount a persistent disk/volume in production)
MODEL_STORAGE_DIR="./server/saved-model"
